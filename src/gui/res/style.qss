/*
 * InputLeap modern theme
 */

QWidget {
    background-color: #0f141b;
    color: #e6edf7;
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #0f141b;
}

QMenuBar {
    background-color: #121924;
    color: #c7d3e3;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #1c2736;
    color: #ffffff;
}

QMenu {
    background-color: #141c28;
    border: 1px solid #263243;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 26px 7px 14px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #223452;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #263243;
    margin: 6px 10px;
}

QPushButton {
    background-color: #1a2433;
    color: #e6edf7;
    border: 1px solid #2a3a50;
    border-radius: 10px;
    padding: 8px 18px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #22304a;
    border-color: #3b5273;
}
QPushButton:pressed {
    background-color: #182233;
}
QPushButton:disabled {
    color: #64748b;
    border-color: #223042;
    background-color: #141b26;
}
QPushButton:focus {
    border-color: #2f6fed;
}
QPushButton#m_pButtonStart {
    background-color: #2f6fed;
    border: 1px solid #2f6fed;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#m_pButtonStart:hover {
    background-color: #3d7bf5;
}
QPushButton#m_pButtonStart:disabled {
    background-color: #1d3055;
    border-color: #1d3055;
    color: #7f95b8;
}
QPushButton#m_pButtonStop {
    background-color: #2a2130;
    border: 1px solid #4a2b3a;
    color: #ffb4c2;
}
QPushButton#m_pButtonStop:hover {
    background-color: #3a283f;
}

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #121a26;
    border: 1px solid #263243;
    border-radius: 9px;
    padding: 7px 10px;
    selection-background-color: #2f6fed;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #2f6fed;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox QAbstractItemView {
    background-color: #141c28;
    border: 1px solid #2a3a50;
    border-radius: 8px;
    selection-background-color: #223452;
    padding: 4px;
    outline: none;
}

QGroupBox {
    border: 1px solid #223042;
    border-radius: 12px;
    margin-top: 14px;
    padding-top: 10px;
    background-color: #111825;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #8fa4c2;
    font-weight: 600;
}

QLabel {
    background: transparent;
    color: #c7d3e3;
}
QLabel#m_pLabelStatus, QLabel#m_pLabelMessage {
    color: #8fa4c2;
}

QCheckBox, QRadioButton {
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #2a3a50;
    background-color: #121a26;
}
QCheckBox::indicator {
    border-radius: 5px;
}
QRadioButton::indicator {
    border-radius: 9px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2f6fed;
    border-color: #2f6fed;
}

QTabWidget::pane {
    border: 1px solid #223042;
    border-radius: 12px;
    top: -1px;
    background-color: #111825;
}
QTabBar::tab {
    background: transparent;
    color: #8fa4c2;
    padding: 8px 16px;
    margin-right: 4px;
    border-radius: 8px;
}
QTabBar::tab:selected {
    background-color: #1c2736;
    color: #ffffff;
}
QTabBar::tab:hover {
    color: #dbe6f5;
}

QListWidget, QTreeView, QTableView {
    background-color: #111825;
    border: 1px solid #223042;
    border-radius: 10px;
    outline: none;
    alternate-background-color: #121b28;
    selection-background-color: #223452;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #16202d;
    color: #8fa4c2;
    border: none;
    border-bottom: 1px solid #223042;
    padding: 6px 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #2a3a50;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #3b5273;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #2a3a50;
    border-radius: 5px;
    min-width: 28px;
}

QStatusBar {
    background-color: #121924;
    color: #8fa4c2;
}
QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #16202d;
    color: #e6edf7;
    border: 1px solid #2a3a50;
    border-radius: 8px;
    padding: 6px 8px;
}

QProgressBar {
    background-color: #121a26;
    border: 1px solid #263243;
    border-radius: 8px;
    text-align: center;
    color: #dbe6f5;
    min-height: 16px;
}
QProgressBar::chunk {
    border-radius: 8px;
    background-color: #2f6fed;
}
